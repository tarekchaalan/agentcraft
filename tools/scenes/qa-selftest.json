{
  "description": "Self-test of the scene runner (tools/lib/scene.mjs) against any running game + showcase Foreman: scene anchor fallback table, raw camera + offset, a vanilla screen with typing, Foreman diff/ack messages through templates, a template that cannot resolve (skip), dev requests and per-shot waits. node tools/capture-screenshots.mjs tools/scenes/qa-selftest.json --foreman <port> --port <devPort> --prefix selftest/",
  "foreman": { "connect": true },
  "defaults": { "time": 6000, "weather": "clear", "mode": "spectator" },
  "anchors": {
    "cam_selftest_scene": { "x": 20, "y": 70, "z": -6, "lookAt": { "x": 9, "y": 67, "z": 9 }, "fov": 80 }
  },
  "shots": [
    { "name": "st01_scene_anchor", "anchor": ["cam_missing_on_purpose", "cam_selftest_scene"] },
    {
      "name": "st02_raw_offset",
      "camera": { "x": -4, "y": 72, "z": -8, "yaw": -37.4, "pitch": 13.1 },
      "offset": { "dx": 2, "dyaw": 10 },
      "fov": 77
    },
    {
      "name": "st03_chat_type",
      "camera": { "x": 9, "y": 67, "z": -4, "yaw": 0, "pitch": 5 },
      "screen": "chat",
      "type": "@ju hello from {{agents.juniper.name}} ({{merge.id}} open)",
      "waitFrames": 5,
      "hideHud": false
    },
    {
      "name": "st04_foreman_messages",
      "camera": { "x": 9, "y": 67, "z": -4, "yaw": 0, "pitch": 5 },
      "foreman": [
        { "type": "diff.request", "repoId": "{{merge.repoId}}", "worktree": "{{merge.worktree}}", "minFiles": 2 },
        { "type": "user.message", "to": "juniper", "text": "QA self-test ping (ignore)" }
      ],
      "waitFor": { "foreman": "question.id", "exists": true, "timeoutMs": 5000 },
      "waitMs": 500
    },
    {
      "name": "st05_unresolvable_template",
      "camera": { "x": 9, "y": 67, "z": -4, "yaw": 0, "pitch": 5 },
      "foreman": [ { "type": "decision.answer", "decisionId": "{{permission.id}}", "option": "Deny" } ]
    },
    {
      "name": "st06_dev_requests",
      "camera": { "x": 9, "y": 67, "z": -4, "yaw": 0, "pitch": 5 },
      "dev": [ { "type": "dev.hud", "hidden": false } ],
      "time": 12000,
      "hideHud": false,
      "waitFor": { "path": "world.time", "gte": 12000, "timeoutMs": 5000 }
    }
  ]
}
